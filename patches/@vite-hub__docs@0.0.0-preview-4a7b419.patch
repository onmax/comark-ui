+<script setup lang="ts">
+// The share image of every docs page, in the `vercel` theme: the site, the page title and description, and the section.
+// The build renders it once per page while prerendering, so the Worker carries no renderer.
+withDefaults(defineProps<{
+  title?: string
+  description?: string
+  site?: string
+  section?: string
+  logo?: string
+  host?: string
+}>(), { title: "", description: "", site: "", section: "", logo: "", host: "" })
+</script>
+
+<template>
+  <div class="w-full h-full flex flex-col justify-between bg-white text-black p-[72px]" style="font-family: Geist">
+    <div class="flex items-center gap-4">
+      <img v-if="logo" :src="logo" alt="" class="w-12 h-12">
+      <span class="text-[36px] font-semibold" style="letter-spacing: -0.02em">{{ site }}</span>
+      <span v-if="section" class="text-[36px] text-neutral-400">/</span>
+      <span v-if="section" class="text-[36px] text-neutral-500">{{ section }}</span>
+    </div>
+
+    <div class="flex flex-col gap-6">
+      <span class="text-[76px] font-semibold" style="line-height: 1.05; letter-spacing: -0.045em; text-wrap: balance">{{ title }}</span>
+      <span v-if="description" class="text-[34px] text-neutral-500" style="line-height: 1.35; line-clamp: 2; text-overflow: ellipsis; overflow: hidden">{{ description }}</span>
+    </div>
+
+    <div class="flex items-center justify-between border-t border-neutral-200 pt-8">
+      <span class="text-[26px] text-neutral-500" style="font-family: 'Geist Mono'">{{ host }}</span>
+      <div class="flex w-[56px] h-[8px] bg-black" />
+    </div>
+  </div>
+</template>
diff --git a/dist/runtime/app/composables/seo.ts b/dist/runtime/app/composables/seo.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d5ffa31f295e33c080a89fdf5b9208384f218687
--- /dev/null
+++ b/dist/runtime/app/composables/seo.ts
@@ -0,0 +1,54 @@
+import { defineArticle, defineBreadcrumb, defineOgImage, defineWebPage, useRoute, useSchemaOrg, useSeoMeta } from "#imports"
+import { docsAppPath, normalizeDocsPath } from "#docs/navigation"
+
+import { useDocsConfig } from "./docs"
+
+export interface DocsSeoInput {
+  title: string
+  description?: string | null
+  /** Section label in the share image and the breadcrumb, such as `KV`. */
+  section?: { title: string, path: string } | null
+  /** A path in `public/` or a URL for the share image, or `false` for none. Without it the build renders one. */
+  image?: string | false
+  /** `article` marks the page a TechArticle in Schema.org. */
+  type?: "article" | "page"
+}
+
+/**
+ * Title, description, share image, and Schema.org of a page. Docs pages call it with their frontmatter; an app page,
+ * such as a playground, calls it to look the same when shared.
+ */
+export function useDocsSeo(input: DocsSeoInput): void {
+  const { site, appBase, ogImage } = useDocsConfig()
+  const route = useRoute()
+  const path = docsAppPath(normalizeDocsPath(route.path), appBase)
+  // A section's own Overview names the section already.
+  const section = input.section && input.section.path !== path ? input.section : null
+  const description = input.description ?? site.description ?? undefined
+  useSeoMeta({ title: input.title, ogTitle: input.title, description, ogDescription: description })
+
+  if (input.image) {
+    const image = /^https?:\/\//.test(input.image) ? input.image : `${site.url}${docsAppPath(input.image, appBase)}`
+    useSeoMeta({ ogImage: image, twitterImage: image })
+  }
+  else if (input.image !== false && ogImage) {
+    // SAFETY: `ogImage.component` is an OgImage component; the default ships with this package, and an app names its own.
+    defineOgImage(ogImage.component as "DocsPage", {
+      title: input.title,
+      description: description ?? "",
+      site: site.name,
+      section: section?.title ?? "",
+      // A path, so the prerender reads the file from the build instead of fetching the site before it is deployed.
+      logo: site.logo ?? "",
+      host: site.url.replace(/^https?:\/\//, ""),
+    })
+  }
+
+  useSchemaOrg([
+    defineWebPage({ name: input.title, description }),
+    ...input.type === "article" ? [defineArticle({ "@type": "TechArticle", "headline": input.title, description })] : [],
+    ...section
+      ? [defineBreadcrumb({ itemListElement: [{ name: site.name, item: docsAppPath("/", appBase) }, { name: section.title, item: section.path }, { name: input.title }] })]
+      : [],
+  ])
+}
