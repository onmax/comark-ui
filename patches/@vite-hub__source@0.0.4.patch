+//#region src/core/split-source.d.ts
+/** One part of a parent item. Its key is unique inside the parent and has no `#`. */
+type SplitSourcePart = SourceItem<string, unknown, object>;
+interface SplitSourceOptions<TSource extends Source, TPart extends SplitSourcePart> {
+  /** The Source whose items are split. */
+  source: TSource;
+  /** Defaults to the parent Source name. */
+  name?: string;
+  /** Returns the parts of one parent item, in order. Return an empty array to skip the item. */
+  split(item: Awaited<ReturnType<TSource["getItem"]>>): readonly TPart[] | Promise<readonly TPart[]>;
+}
+/** A part's key: the parent key, `#`, and the part key. */
+type SplitSourceKey<TSource extends Source> = `${Extract<Parameters<TSource["getItem"]>[0], string>}#${string}`;
+/** A part as the split Source returns it: its full key, and the parent's path when the part has none. */
+type SplitSourceItem<TSource extends Source, TPart extends SplitSourcePart> = Omit<TPart, "key"> & {
+  key: SplitSourceKey<TSource>;
+};
+/** A Source with one item for each part of another Source's items. */
+type SplitSource<TSource extends Source, TPart extends SplitSourcePart> = Source<SplitSourceKey<TSource>> & {
+  getItem(key: SplitSourceKey<TSource>, ctx: SourceContext): Promise<SplitSourceItem<TSource, TPart>>;
+  getItems(ctx: SourceContext): Promise<SplitSourceItem<TSource, TPart>[]>;
+};
+/** Split each item of a Source into parts, such as the sections of a Markdown file. Each part is an item. */
+declare function splitSource<const TSource extends Source, TPart extends SplitSourcePart>(options: SplitSourceOptions<TSource, TPart>): SplitSource<TSource, TPart>;
