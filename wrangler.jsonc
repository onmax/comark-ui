{
  "name": "comark-ui",
  // Nitro's output, from `pnpm docs:generate`. The build merges this file with ViteHub's bindings (D1, the secrets) into
  // docs/dist/server/wrangler.json and points .wrangler/deploy/config.json at it, so `wrangler deploy` from here
  // deploys that one.
  "main": "docs/dist/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker runs first so an agent that asks for Markdown gets the page's copy. Nitro's middleware then serves the
  // prerendered file through ASSETS (docs/server/middleware/assets.ts). Pages live at /zoom, with no trailing slash.
  "assets": {
    "directory": "./docs/dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "comark-ui.onmax.me", "custom_domain": true }],
  // Workers Builds runs `wrangler preview` for branches other than main, which needs this block.
  "previews": {}
}
