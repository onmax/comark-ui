{
  "name": "remark-to-comark",
  "version": "0.8.1",
  "description": "Moves a project from remark to Comark: reports each remark setup and what its plugins become, rewrites unified chains to Comark's renderHtml, and escapes Markdown Comark would read differently. A CLI, a library, and a Vite Doctor extension.",
  "keywords": [
    "codemod",
    "comark",
    "markdown",
    "migration",
    "rehype",
    "remark",
    "unified",
    "vite-doctor"
  ],
  "homepage": "https://comark-ui.onmax.me/remark-to-comark",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/remark-to-comark"
  },
  "bin": {
    "remark-to-comark": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./doctor": "./dist/doctor.mjs",
    "./plugins": "./dist/plugins/index.mjs",
    "./setup": "./dist/setup.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter remark-to-comark... build"
  },
  "dependencies": {
    "entities": "^9.0.0",
    "github-slugger": "^2.0.0",
    "magic-string": "^1.4.5",
    "markdown-it-footnote": "^4.0.0",
    "nostics": "^1.3.0",
    "npm-to-yarn": "^3.2.0",
    "oxc-parser": "^0.156.0",
    "property-information": "^7.2.0",
    "reading-time": "^1.5.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.1.0"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@types/hast": "^3.0.5",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "comark": "catalog:",
    "diff": "^9.0.0",
    "hast-util-from-html": "^2.0.3",
    "katex": "catalog:",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark": "^15.0.1",
    "remark-gemoji": "^8.0.0",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-html": "^16.0.1",
    "remark-mdc": "^3.11.1",
    "remark-squeeze-paragraphs": "^6.0.0",
    "vite-doctor": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.8.0",
    "vite-doctor": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "vite-doctor": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
