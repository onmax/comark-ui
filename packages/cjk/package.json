{
  "name": "comark-cjk",
  "version": "0.6.1",
  "description": "Bold and italics that work next to Chinese, Japanese, and Korean punctuation in Comark, as in **この文は太字。**次の文.",
  "keywords": [
    "chinese",
    "cjk",
    "comark",
    "emphasis",
    "japanese",
    "korean",
    "markdown",
    "mdc",
    "plugin"
  ],
  "homepage": "https://comark-ui.onmax.me/cjk",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/cjk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-cjk build"
  },
  "dependencies": {
    "markdown-it-cjk-friendly": "catalog:"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "comark": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
