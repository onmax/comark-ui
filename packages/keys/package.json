{
  "name": "comark-keys",
  "version": "0.7.5",
  "description": "Keyboard keys in Comark: ++ctrl+shift+k++ renders each key as a <kbd>, with pymdownx.keys' names and aliases.",
  "keywords": [
    "comark",
    "kbd",
    "keyboard",
    "keys",
    "markdown",
    "mdc",
    "plugin",
    "pymdownx",
    "shortcut"
  ],
  "homepage": "https://comark-ui.onmax.me/keys",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/keys"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-keys build"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "comark": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
