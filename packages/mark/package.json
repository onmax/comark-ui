{
  "name": "comark-mark",
  "version": "0.5.0",
  "description": "Highlights and superscripts in Comark: ==marked text== as <mark> and ^sup^ as <sup>.",
  "keywords": [
    "comark",
    "highlight",
    "mark",
    "markdown",
    "mdc",
    "plugin",
    "superscript"
  ],
  "homepage": "https://comark-ui.onmax.me/mark",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/mark"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-mark build"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "comark": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
