{
  "name": "comark-charts",
  "version": "0.6.0",
  "description": "Charts from a Markdown table, drawn to SVG while parsing, with no script: bars, stacked bars, lines, areas, scatter plots, dumbbells, waterfalls, pies, gantt charts, and sankeys. The table stays in the page, so people see the chart and agents read the numbers. A Comark plugin.",
  "keywords": [
    "chart",
    "comark",
    "flint",
    "markdown",
    "mdc",
    "plugin",
    "sankey",
    "svg",
    "vega"
  ],
  "homepage": "https://comark-ui.onmax.me/charts",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/charts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./html": "./dist/html.mjs",
    "./react": "./dist/react.mjs",
    "./style.css": "./dist/style.css",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-charts... build"
  },
  "dependencies": {
    "comark-annotate": "workspace:*",
    "d3-sankey": "catalog:",
    "flint-chart": "catalog:",
    "vega": "catalog:",
    "vega-interpreter": "catalog:",
    "vega-lite": "catalog:"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@comark/react": "catalog:",
    "@comark/vue": "catalog:",
    "@types/d3-sankey": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "comark": "catalog:",
    "comark-zoom": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@comark/html": "^0.8.0",
    "comark": "^0.8.0",
    "react": ">=18",
    "svelte": ">=5",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@comark/html": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
