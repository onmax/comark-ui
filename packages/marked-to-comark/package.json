{
  "name": "marked-to-comark",
  "version": "0.12.0",
  "description": "Moves a project from marked to Comark: reports each marked setup and what its options and extensions become, rewrites marked calls to Comark's renderHtml, and escapes Markdown Comark would read differently. A CLI, a library, and a Vite Doctor extension.",
  "keywords": [
    "codemod",
    "comark",
    "markdown",
    "marked",
    "migration",
    "vite-doctor"
  ],
  "homepage": "https://comark-ui.onmax.me/marked-to-comark",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/marked-to-comark"
  },
  "bin": {
    "marked-to-comark": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./doctor": "./dist/doctor.mjs",
    "./plugins": "./dist/plugins/index.mjs",
    "./setup": "./dist/setup.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter marked-to-comark... build"
  },
  "dependencies": {
    "entities": "^9.0.0",
    "magic-string": "^1.4.5",
    "marked": "^18.1.2",
    "nostics": "^1.3.0",
    "oxc-parser": "^0.156.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@types/hast": "^3.0.5",
    "comark": "catalog:",
    "diff": "^9.0.0",
    "hast-util-from-html": "^2.0.3",
    "marked-highlight": "^2.2.4",
    "property-information": "^7.2.0",
    "vite-doctor": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.9.0",
    "vite-doctor": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "vite-doctor": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
