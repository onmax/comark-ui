{
  "name": "comark-tests",
  "version": "0.8.0",
  "description": "Test results from a JUnit XML report: pass, fail, and skip counts, the duration, and each failure with its stack. A Comark plugin.",
  "keywords": [
    "ci",
    "comark",
    "junit",
    "markdown",
    "mdc",
    "plugin",
    "test-results",
    "tests"
  ],
  "homepage": "https://comark-ui.onmax.me/tests",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/tests"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./html": "./dist/html.mjs",
    "./react": "./dist/react.mjs",
    "./style.css": "./dist/style.css",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-tests... build"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@comark/react": "catalog:",
    "@comark/vue": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "comark": "catalog:",
    "comark-zoom": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@comark/html": "^0.8.0",
    "comark": "^0.8.0",
    "react": ">=18",
    "svelte": ">=5",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@comark/html": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
