{
  "name": "comark-diff",
  "version": "0.7.7",
  "description": "A code change in Markdown, shown like a suggested change in a pull request review: the file, red and green lines, and the words that changed. A Comark plugin.",
  "keywords": [
    "code-review",
    "comark",
    "diff",
    "markdown",
    "mdc",
    "plugin",
    "suggested-change"
  ],
  "homepage": "https://comark-ui.onmax.me/diff",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/diff"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./html": "./dist/html.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-zoom build && pnpm --filter comark-diff build"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "comark": "catalog:",
    "comark-zoom": "workspace:*"
  },
  "peerDependencies": {
    "@comark/html": "^0.8.0",
    "comark": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "@comark/html": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
