{
  "name": "markdown-it-to-comark",
  "version": "0.11.0",
  "description": "Moves a project from markdown-it to Comark: reports each markdown-it setup and what its plugins and options become, rewrites setups it owns to Comark's renderHtml, and escapes Markdown Comark would read differently. A CLI, a library, and a Vite Doctor extension.",
  "keywords": [
    "codemod",
    "comark",
    "markdown",
    "markdown-it",
    "migration",
    "vite-doctor"
  ],
  "homepage": "https://comark-ui.onmax.me/markdown-it-to-comark",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/markdown-it-to-comark"
  },
  "bin": {
    "markdown-it-to-comark": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./doctor": "./dist/doctor.mjs",
    "./plugins": "./dist/plugins/index.mjs",
    "./setup": "./dist/setup.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter markdown-it-to-comark... build"
  },
  "dependencies": {
    "entities": "^9.0.0",
    "magic-string": "^1.4.5",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "nostics": "^1.3.0",
    "oxc-parser": "^0.156.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.10",
    "@types/markdown-it-footnote": "^3.0.4",
    "comark": "catalog:",
    "diff": "^9.0.0",
    "hast-util-from-html": "^2.0.3",
    "katex": "catalog:",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "property-information": "^7.2.0",
    "vite-doctor": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.9.0",
    "vite-doctor": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "vite-doctor": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
