{
  "name": "comark-ui",
  "version": "0.8.2",
  "description": "Every comark-ui block in one install: annotated screenshots, charts, diffs, tabs, zoom, and more, registered in the order they need with shared icons. Turn any of them off or pass its options.",
  "keywords": [
    "comark",
    "components",
    "markdown",
    "plugin",
    "preset",
    "ui"
  ],
  "homepage": "https://comark-ui.onmax.me",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./editor": "./dist/editor.mjs",
    "./editor/vue": "./dist/editor-vue.mjs",
    "./html": "./dist/html.mjs",
    "./nuxt-ui": "./dist/nuxt-ui.mjs",
    "./react": "./dist/react.mjs",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json",
    "./skills": "./dist/skills.mjs",
    "./skills/*": "./dist/skills/*",
    "./typeset.css": "./dist/typeset.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-ui... build",
    "playground": "vp dev playground --port 5199"
  },
  "dependencies": {
    "comark-annotate": "workspace:^",
    "comark-badge": "workspace:^",
    "comark-cards": "workspace:^",
    "comark-carousel": "workspace:^",
    "comark-cast": "workspace:^",
    "comark-charts": "workspace:^",
    "comark-chips": "workspace:^",
    "comark-cjk": "workspace:^",
    "comark-code": "workspace:^",
    "comark-code-notes": "workspace:^",
    "comark-colors": "workspace:^",
    "comark-comments": "workspace:^",
    "comark-critic": "workspace:^",
    "comark-deflist": "workspace:^",
    "comark-details": "workspace:^",
    "comark-diagrams": "workspace:^",
    "comark-diff": "workspace:^",
    "comark-embed": "workspace:^",
    "comark-fields": "workspace:^",
    "comark-figure": "workspace:^",
    "comark-file-tree": "workspace:^",
    "comark-footnotes": "workspace:^",
    "comark-github": "workspace:^",
    "comark-icon": "workspace:^",
    "comark-include": "workspace:^",
    "comark-keys": "workspace:^",
    "comark-links": "workspace:^",
    "comark-magic-move": "workspace:^",
    "comark-mark": "workspace:^",
    "comark-mathml": "workspace:^",
    "comark-media": "workspace:^",
    "comark-metrics": "workspace:^",
    "comark-outline": "workspace:^",
    "comark-pele": "catalog:",
    "comark-properties": "workspace:^",
    "comark-qr": "workspace:^",
    "comark-quiz": "workspace:^",
    "comark-reading-time": "workspace:^",
    "comark-sources": "workspace:^",
    "comark-steps": "workspace:^",
    "comark-table": "workspace:^",
    "comark-tabs": "workspace:^",
    "comark-tests": "workspace:^",
    "comark-xref": "workspace:^",
    "comark-zoom": "workspace:^"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@comark/react": "catalog:",
    "@comark/vue": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@tiptap/y-tiptap": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "comark": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vue": "catalog:",
    "yjs": "catalog:"
  },
  "peerDependencies": {
    "@comark/html": "^0.8.0",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-list": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/vue-3": "^3.31.0",
    "comark": "^0.8.0",
    "react": ">=18",
    "svelte": ">=5.20",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@comark/html": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/vue-3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
