{
  "name": "comark-linter",
  "version": "0.6.0",
  "description": "Finds unclosed blocks, unknown components, broken links and anchors, local URLs, and plugin issues in Comark documents. A library, a CLI, an ESLint plugin, and a Vite Doctor extension.",
  "keywords": [
    "comark",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "lint",
    "markdown",
    "mdc",
    "vite-doctor"
  ],
  "homepage": "https://comark-ui.onmax.me/lint",
  "bugs": "https://github.com/onmax/comark-ui/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-ui.git",
    "directory": "packages/lint"
  },
  "bin": {
    "lint-comark": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./doctor": "./dist/doctor.mjs",
    "./eslint": "./dist/eslint.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-linter... build"
  },
  "devDependencies": {
    "@eslint/markdown": "catalog:",
    "comark": "catalog:",
    "comark-annotate": "workspace:*",
    "comark-badge": "workspace:*",
    "comark-cards": "workspace:*",
    "comark-carousel": "workspace:*",
    "comark-cast": "workspace:*",
    "comark-charts": "workspace:*",
    "comark-chips": "workspace:*",
    "comark-cjk": "workspace:*",
    "comark-code": "workspace:*",
